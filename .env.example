NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_ORIGIN=http://localhost:3000

# Optional until Postgres is connected. App boots without these.
DATABASE_URL=
DIRECT_URL=

# Optional until Supabase Auth/Storage is wired.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional until Inngest is wired. No events are sent in this scaffold.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
